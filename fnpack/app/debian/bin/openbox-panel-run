#!/bin/sh
# openbox-panel-run —— 面板启动器（fnOS 版）
#
# 由上游 debian/bin/openbox-panel-run 改编：
#   · ROOT 取自 OPENBOX_ROOT，未设置时按脚本位置自定位（../../）；
#   · 不再创建 /usr/local/bin/open-box 软链接（不污染系统目录，CLI 位于
#     $ROOT/openwrt/bin/open-box）；
#   · 端口兜底值 3036（fnOS 上没有 v0.1.216 及更早的老安装，不存在 2026）；
#   · 每次启动把 ui/config 里的 iframe 端口同步成实际面板端口。
#
# v0.1.319 起（前置代理方案）：面板进程只听内网端口 3037，对外端口（panel-port）
# 由 debian/bin/openbox-front.mjs 前置代理把守——它把 /api/fnoscf/* 分流给隧道
# 助手、其余转给面板。
#
# v0.1.463 起（上游 fpk 0.1.328 适配）：面板是纯静态 Go 二进制 bin/openbox-panel
# （meta.json panelRuntime=go-static，发布包不再有 node/ 与 panel/server）。
# 我们的 helper（front/gateway/cf-tunnel.mjs）仍是 Node 脚本，构建时随包一个
# helper 专用 node（app/node/），只有面板本身不再用 Node。

ROOT="${OPENBOX_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
PANEL_BIN="$ROOT/bin/openbox-panel"
DATA="$ROOT/data"

if [ ! -x "$PANEL_BIN" ]; then
	echo "openbox-panel: binary not found at $PANEL_BIN" >&2
	exit 1
fi
mkdir -p "$DATA"

# 对外端口（fpk 声明/应用中心/iframe/ui/config 用的都是它）
panel_port=$(cat "$DATA/panel-port" 2>/dev/null | tr -dc '0-9')
[ -n "$panel_port" ] || panel_port=3036
# 内网端口：面板进程实际监听 3037（前置代理把守对外端口）。三处约定必须一致：
# openbox-panel-run / openbox-front.mjs / openbox-gateway.mjs。
internal_port=3037
if command -v node >/dev/null 2>&1 && [ -x "$ROOT/node/bin/node" ]; then
	"$ROOT/node/bin/node" -e 'require("node:net").connect(Number(process.argv[1]),"127.0.0.1").on("connect",function(){process.exit(0)}).on("error",function(){process.exit(1)})' "$internal_port" 2>/dev/null \
		&& { echo "openbox-panel: internal port $internal_port is already in use" >&2; exit 1; }
fi

# fnOS 桌面入口（ui/config）的端口跟随面板端口（改端口后重启面板即同步）
if [ -f "$ROOT/ui/config" ]; then
	sed -i "s/\"port\": \"[0-9]*\"/\"port\": \"$panel_port\"/" "$ROOT/ui/config" 2>/dev/null || true
fi

# HOST=:: 双栈（没开 IPv6 时 Go 面板自己退回 0.0.0.0）
export PORT="$internal_port" HOST=:: OPENBOX_ROOT="$ROOT" \
	ZASHBOARD_DB_PATH="$DATA/openbox.sqlite" OPENBOX_PLATFORM=systemd
unset LD_LIBRARY_PATH
unset LD_PRELOAD
exec "$PANEL_BIN" serve

#!/bin/bash
# ---------------------------------------------------------------------------
# Open-Box fnOS package — common functions
# Adapted from the fnSoar (fnOS) package layout: lifecycle hooks + daemon
# management used by cmd/main, cmd/installer and the *_init / *_callback
# entry points.
# ---------------------------------------------------------------------------

# fnOS lifecycle scripts run with no PATH. Export a sane default.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

RM="/bin/rm -rf"
MKDIR="/bin/mkdir -p"
TEE="/usr/bin/tee -a"

# ── Data path safety check ────────────────────────────────────────────────
if [ -z "${TRIM_PKGVAR:-}" ]; then
    echo "ERROR: TRIM_PKGVAR not set" >&2
    exit 1
fi
case "${TRIM_PKGVAR}" in
    /vol*) ;;
    /usr/local/apps/@appdata/*) ;;
    *) echo "ERROR: TRIM_PKGVAR=${TRIM_PKGVAR} is not a valid data path" >&2; exit 1 ;;
esac
$MKDIR "${TRIM_PKGVAR}" 2>/dev/null || true

# ── Key paths ─────────────────────────────────────────────────────────────
INST_ETC="/var/apps/${TRIM_APPNAME}/etc"
INST_VARIABLES="${INST_ETC}/installer-variables"
INST_LOG="/var/log/apps/${TRIM_APPNAME}.log"

LOG_FILE="${TRIM_PKGVAR}/openbox.log"
PID_FILE="${TRIM_PKGVAR}/openbox.pid"

SVC_WAIT_TIMEOUT=15
SVC_CWD="${TRIM_PKGVAR}"
SVC_BACKGROUND=y
SVC_WRITE_PID=y
SVC_QUIET=y

DNAME="${TRIM_APPNAME}"

OUT=/dev/null
if [ -n "${SVC_NO_REDIRECT:-}" ]; then
    OUT="/dev/null"
else
    OUT="${LOG_FILE}"
fi

# ── Error display to user (fnOS ≥1.1.8) ──────────────────────────────────
error_exit()
{
    local msg="$1"
    if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
        echo "$msg" > "${TRIM_TEMP_LOGFILE}"
    fi
    echo "ERROR: $msg" >&2
    exit 1
}

# ── Lifecycle hooks (overridden in service-setup) ─────────────────────────
validate_preinst()   { echo "validate_preinst"; }
service_preinst()    { echo "service_preinst"; }
service_postinst()   { echo "service_postinst"; }
service_preuninst()  { echo "service_preuninst"; }
service_postuninst() { echo "service_postuninst"; }
validate_preupgrade(){ echo "validate_preupgrade"; }
service_preupgrade() { echo "service_preupgrade"; }
service_save()       { echo "service_save"; }
service_restore()    { echo "service_restore"; }
service_postupgrade(){ echo "service_postupgrade"; }
service_preconfig()  { echo "service_preconfig"; }
service_postconfig() { echo "service_postconfig"; }

# ── Logging ───────────────────────────────────────────────────────────────
install_log()
{
    local _msg_="$@"
    if [ -z "${_msg_}" ]; then
        while IFS=$'\n' read -r line; do
            install_log "${line}"
        done
    else
        echo -e "$(date +'%Y/%m/%d %H:%M:%S')\t${_msg_}" 1>&2
    fi
}

call_func()
{
    FUNC=$1
    LOG=$2
    if type "${FUNC}" 2>/dev/null | grep -q 'function' 2>/dev/null; then
        if [ -n "${LOG}" ]; then
            install_log "Begin ${FUNC}"
            eval ${FUNC} 2>&1 | ${LOG}
            install_log "End ${FUNC}"
        else
            echo "Begin ${FUNC}" >> ${LOG_FILE}
            eval ${FUNC}         >> ${LOG_FILE}
            echo "End ${FUNC}"   >> ${LOG_FILE}
        fi
    fi
}

log_step()
{
    install_log "===> Step $1. STATUS=${TRIM_APP_STATUS} USER=$USER GROUP=$GROUP"
}

load_variables_from_file()
{
    if [ -n "$1" -a -r "$1" ]; then
        while read -r _line; do
            if [ "$(echo ${_line} | grep -v ^[/s]*#)" != "" ]; then
                _key="$(echo ${_line} | cut --fields=1 --delimiter==)"
                _value="$(echo ${_line} | cut --fields=2- --delimiter==)"
                export "${_key}=${_value}"
            fi
        done < "$1"
    fi
}

save_wizard_variables()
{
    if [ -e "${INST_VARIABLES}" ]; then
        $RM "${INST_VARIABLES}"
    fi
    $MKDIR "${INST_ETC}" 2>/dev/null || true
    if [ -n "${wizard_panel_port:-}" ]; then
        echo "wizard_panel_port=${wizard_panel_port}" >> ${INST_VARIABLES}
    fi
}

# ── Lifecycle entry points ────────────────────────────────────────────────
install_init()
{
    log_step "install_init"
    call_func "validate_preinst" install_log
    call_func "service_preinst" install_log
    exit 0
}

install_callback()
{
    log_step "install_callback"
    call_func "save_wizard_variables" install_log
    call_func "service_postinst" install_log
    if [ -n "${LOG_FILE}" ]; then
        echo "Installation log: ${INST_LOG}" >> ${LOG_FILE}
    fi
    exit 0
}

uninstall_init()
{
    log_step "uninstall_init"
    stop_daemon
    call_func "service_preuninst" install_log
    exit 0
}

uninstall_callback()
{
    log_step "uninstall_callback"
    call_func "service_postuninst" install_log
    if [ "${wizard_delete_data:-false}" = "true" ]; then
        echo "Removing files..." | install_log
        if [ -d "${TRIM_PKGVAR}" ] && [ "$(ls -A ${TRIM_PKGVAR})" != "" ]; then
            find ${TRIM_PKGVAR} -mindepth 1 -delete -print | install_log
        fi
        if [ -d "/var/apps/${TRIM_APPNAME}/etc" ] && [ "$(ls -A /var/apps/${TRIM_APPNAME}/etc)" != "" ]; then
            find /var/apps/${TRIM_APPNAME}/etc -mindepth 1 -delete -print | install_log
        fi
    fi
    exit 0
}

upgrade_init()
{
    log_step "upgrade_init"
    call_func "validate_preupgrade" install_log
    stop_daemon
    call_func "service_preupgrade" install_log
    call_func "service_save" install_log
    exit 0
}

fix_data_ownership()
{
    if [ -n "${TRIM_USERNAME:-}" ] && [ -n "${TRIM_GROUPNAME:-}" ]; then
        local owner="${TRIM_USERNAME}:${TRIM_GROUPNAME}"
        for dir in "${TRIM_PKGVAR}" "${TRIM_PKGETC:-}" "${TRIM_PKGHOME:-}"; do
            [ -n "$dir" ] && [ -d "$dir" ] && chown -R "$owner" "$dir" 2>/dev/null || true
        done
    fi
}

upgrade_callback()
{
    log_step "upgrade_callback"
    call_func "fix_data_ownership" install_log
    call_func "service_restore" install_log
    call_func "service_postupgrade" install_log
    exit 0
}

config_init()
{
    log_step "config_init"
    call_func "service_preconfig" install_log
    exit 0
}

config_callback()
{
    log_step "config_callback"
    call_func "service_postconfig" install_log
    exit 0
}

# ── Daemon management ─────────────────────────────────────────────────────
# The single-line SERVICE_COMMAND (see service-setup) is backgrounded by
# start_daemon and its PID captured into PID_FILE. The command itself is the
# openbox-supervise script shipped in the app payload: it starts the panel
# (and the kernel when autostart is on) and traps SIGTERM for a clean
# shutdown of panel + kernel + nftables/ip-rule/system state.
start_daemon()
{
    i=0
    if [ -z "${SVC_QUIET}" ]; then
        date > ${LOG_FILE}
    fi
    call_func "service_prestart" 2>/dev/null
    printf "%s" "$SERVICE_COMMAND" | while read -r service || [ -n "$service" ]
    do
        i=$((i + 1))
        if [ -z "${SVC_QUIET}" ]; then
            echo "Starting ${DNAME} command ${service}" >> ${LOG_FILE}
        fi
        if [ -n "${service}" ]; then
            if [ -n "${SVC_CWD}" ]; then
                cd ${SVC_CWD}
            fi
            if [ -z "${SVC_BACKGROUND}" ]; then
                ${service} >> ${OUT} 2>&1
            else
                ${service} >> ${OUT} 2>&1 &
            fi
            if [ -n "${SVC_WRITE_PID}" -a -n "${SVC_BACKGROUND}" -a -n "${PID_FILE}" ]; then
                [ $i -eq 1 ] && printf "%s" "$!" > ${PID_FILE} || printf "\n%s" "$!" >> ${PID_FILE}
            else
                wait_for_status 0 ${SVC_WAIT_TIMEOUT:=20}
            fi
        fi
    done

    # Readiness gate: confirm the daemon actually stays up
    if [ -n "${SVC_WRITE_PID}" -a -n "${SVC_BACKGROUND}" -a -n "${PID_FILE}" ]; then
        local svc_pids svc_wait svc_elapsed svc_alive svc_pid
        svc_pids=$(cat "${PID_FILE}" 2>/dev/null)
        if [ -n "${svc_pids}" ]; then
            svc_wait=${SVC_WAIT_TIMEOUT:-15}
            case "${svc_wait}" in ''|*[!0-9]*) svc_wait=15 ;; esac
            [ "${svc_wait}" -lt 1 ] && svc_wait=1
            sleep 1
            svc_elapsed=1
            while [ "${svc_elapsed}" -le "${svc_wait}" ]; do
                if daemon_status "${svc_pids}"; then
                    return 0
                fi
                svc_alive=0
                for svc_pid in ${svc_pids}; do
                    kill -0 "${svc_pid}" 2>/dev/null && svc_alive=$((svc_alive + 1))
                done
                if [ "${svc_alive}" -eq 0 ]; then
                    echo "ERROR: ${DNAME} failed to start, check ${LOG_FILE}" >&2
                    return 1
                fi
                sleep 1
                svc_elapsed=$((svc_elapsed + 1))
            done
        fi
    fi
    return 0
}

stop_daemon()
{
    if [ -n "${PID_FILE}" -a -r "${PID_FILE}" ]; then
        for pid in $(cat "${PID_FILE}")
        do
            if [ -z "$pid" ]; then
                continue
            fi
            kill -TERM ${pid} >> ${LOG_FILE} 2>&1
            wait_for_status 1 ${SVC_WAIT_TIMEOUT:=20} ${pid} || kill -KILL ${pid} >> ${LOG_FILE} 2>&1
        done
        if [ -f "${PID_FILE}" ]; then
            rm -f "${PID_FILE}" > /dev/null
        fi
    fi
    call_func "service_poststop" 2>/dev/null
}

daemon_status()
{
    status=0
    [ -z "${1}" ] && pid_list=$(cat ${PID_FILE} 2>/dev/null) || pid_list=${1}
    if [ -n "${pid_list}" ]; then
        for pid in ${pid_list}
        do
            kill -0 ${pid} > /dev/null 2>&1
            status=$((status + $?))
        done
        if [ $status -ne 0 ]; then
            rm -f "${PID_FILE}" > /dev/null
            return 1
        else
            return 0
        fi
    else
        return 1
    fi
}

wait_for_status()
{
    counter=${2}
    counter=${counter:=20}
    while [ ${counter} -gt 0 ]; do
        daemon_status ${3}
        [ $? -eq $1 ] && return
        counter=$((counter - 1))
        sleep 1
    done
    return 1
}
